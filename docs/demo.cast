{"version": 3, "term": {"cols": 96, "rows": 44}, "timestamp": 1793413543, "idle_time_limit": 2.0, "command": "./scripts/demo.sh", "env": {"SHELL": "/bin/zsh"}}
[0.218, "o", "\r\n\u001b[1m1. two identities, keys generated on device\u001b[0m\r\n"]
[1.433, "o", "identity alice created; public prefix e095782d4c\r\n"]
[0.077, "o", "identity bob created; public prefix 81f1fb00ea\r\n"]
[0.001, "o", "\r\n\u001b[1m2. introductions exchanged out of band (here: files)\u001b[0m\r\n"]
[1.662, "o", "bob staged as Pending; run `unheld verify bob`\r\n"]
[0.152, "o", "alice staged as Pending; run `unheld verify alice`\r\n"]
[0.000, "o", "\r\n\u001b[1m3. sending before verification is refused (L3)\u001b[0m\r\n"]
[1.288, "o", "refused: peer is not verified; run `verify` and compare the digits\r\n"]
[0.000, "o", "exit 2\r\n"]
[0.000, "o", "\r\n\u001b[1m4. the pairwise number is the same on both sides\u001b[0m\r\n"]
[1.287, "o", "refused: fingerprint not confirmed\r\n  95726 52546 02651 93664 72727 20514 93251 22561 12066 31270 42733 55360\r\n"]
[0.081, "o", "refused: fingerprint not confirmed\r\n  95726 52546 02651 93664 72727 20514 93251 22561 12066 31270 42733 55360\r\n"]
[0.000, "o", "\r\n\u001b[1m5. both confirm by voice (here: yes on stdin)\u001b[0m\r\n"]
[1.377, "o", "bob is Verified\r\n"]
[0.154, "o", "alice is Verified\r\n"]
[0.000, "o", "\r\n\u001b[1m6. alice → bob through a file; the file holds a fixed-size blob\u001b[0m\r\n"]
[1.386, "o", "blob: 1366 chars of base64url, 1024 raw bytes\r\n"]
[0.161, "o", "[session started by alice]\r\nalice: the carrier is a trait over bytes\r\n\r\n"]
[0.000, "o", "\r\n\u001b[1m7. bob → alice through a pipe\u001b[0m\r\n"]
[1.495, "o", "bob: and it cannot read this\r\n\r\n"]
[0.001, "o", "\r\n\u001b[1m8. replay is refused (L11)\u001b[0m\r\n"]
[1.283, "o", "refused: message was already opened, or arrived outside the tolerance window\r\n"]
[0.001, "o", "exit 2\r\n"]
[0.000, "o", "\r\n\u001b[1m9. a flipped byte is refused (L8)\u001b[0m\r\n"]
[1.222, "o", "refused: blob is malformed\r\n"]
[0.000, "o", "exit 2\r\n"]
[0.000, "o", "\r\n\u001b[1m10. peers and the vault at rest\u001b[0m\r\n"]
[1.291, "o", "bob              Verified  81f1fb00ea  sessions 1  intro consumed\r\n"]
[0.083, "o", "alice            Verified  e095782d4c  sessions 1  intro unused\r\n"]
[0.000, "o", "vault header: "]
[0.003, "o", "UNHELD01"]
[0.000, "o", "\r\n"]
[0.004, "o", "no plaintext in vault\r\n"]
[4.0, "o", ""]
